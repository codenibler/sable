# Trading 212 read-only credentials. Never commit real values.
TRADING212_API_KEY=
TRADING212_API_SECRET=

# Public endpoints and application constants.
TRADING212_BASE_URL=https://live.trading212.com/api/v0
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BLOCKSTREAM_BASE_URL=https://blockstream.info/api
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
ETHEREUM_EXPLORER_API_URL=https://eth.blockscout.com/api/v2
# Semicolon-separated: CoinGecko ID|symbol|name|mainnet contract|decimals
ETHEREUM_ERC20_TOKENS=chainlink|LINK|Chainlink|0x514910771AF9Ca656af840dff83E8264EcF986CA|18
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# Display defaults.
APP_BASE_CURRENCY=EUR
SNAPSHOT_INTERVAL_MINUTES=60
HTTP_TIMEOUT_SECONDS=15
DATABASE_FILENAME=sable.sqlite3
DATABASE_BACKUP_COUNT=7
TRADING212_HISTORY_MAX_PAGES=5
HISTORY_SYNC_INTERVAL_MINUTES=1440
HISTORY_BACKFILL_RETRY_SECONDS=65
XPUB_GAP_LIMIT=20
XPUB_SCAN_CONCURRENCY=8
XPUB_MAX_ADDRESSES_PER_BRANCH=500
XPUB_REFRESH_INTERVAL_MINUTES=60

# Manual investment baseline. Completed months earn this default rate unless overridden.
OPESSOCIUS_NAME=Opessocius
OPESSOCIUS_CURRENT_BALANCE=8028.05
OPESSOCIUS_NET_DEPOSITS=6200
OPESSOCIUS_MONTHLY_RETURN_RATE=0.02
OPESSOCIUS_RETURN_START_MONTH=2026-08-01
OPESSOCIUS_HISTORY_FILE=data/opessocius-history.csv
NET_WORTH_HISTORY_FILE=data/net-worth-history.csv
NET_WORTH_BACKUP_DIRECTORY=/home/your-user/Net_Worth
NET_WORTH_BACKUP_INTERVAL_DAYS=7

# Optional wallets imported into the local portfolio at startup. Separate multiple
# entries with commas. Extended public keys are sensitive metadata; never commit them.
HWR_BITCOIN_XPUBS=
HWR_ETHEREUM_ADDRESSES=
# Everstake pool contract addresses. Positions are matched to HWR_ETHEREUM_ADDRESSES.
STAKED_ETHEREUM_ADDRESSES=
HWR_SOLANA_ADDRESSES=
STAKED_SOLANA_ADDRESSES=
