# Trading 212 read-only credentials. Never commit real values.
TRADING212_API_KEY=
TRADING212_API_SECRET=

# Public endpoints and application constants.
TRADING212_BASE_URL=https://live.trading212.com/api/v0
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
BLOCKSTREAM_BASE_URL=https://blockstream.info/api
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# Display defaults.
APP_BASE_CURRENCY=EUR
SNAPSHOT_INTERVAL_MINUTES=60
HTTP_TIMEOUT_SECONDS=15
DATABASE_FILENAME=portfolio-1.sqlite3
TRADING212_HISTORY_MAX_PAGES=5
HISTORY_SYNC_INTERVAL_MINUTES=1440
HISTORY_BACKFILL_RETRY_SECONDS=65
XPUB_GAP_LIMIT=20
XPUB_SCAN_CONCURRENCY=8
XPUB_MAX_ADDRESSES_PER_BRANCH=500
XPUB_REFRESH_INTERVAL_MINUTES=60

# Manual investment baseline. Monthly winnings entered in the app are added to this balance.
OPESSOCIUS_NAME=Opessocius
OPESSOCIUS_CURRENT_BALANCE=8028.05
OPESSOCIUS_NET_DEPOSITS=6200

# Optional wallets imported into the local portfolio at startup. Separate multiple
# entries with commas. Extended public keys are sensitive metadata; never commit them.
HWR_BITCOIN_XPUBS=
HWR_ETHEREUM_ADDRESSES=
HWR_SOLANA_ADDRESSES=
