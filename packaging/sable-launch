#!/usr/bin/env bash
# Open Sable from the app launcher: start it only if it is not already up, then focus it.
#
# Sable autostarts at login so its read-only phone API stays reachable, and the window rule in
# hyprland.conf parks that window on workspace 9 with `silent` so it neither steals focus nor
# drags the view across at login. It is an ordinary window on an ordinary workspace, so a
# launcher click just has to focus it -- no special workspace, no toggle, no SUPER ALT P.
#
# Pointing the .desktop entry straight at the AppImage is still wrong: a second launch would
# lose the race for the API port yet keep running, leaving a stray window and a second SQLite
# writer on the same file. Going through this script keeps that to one instance.

set -euo pipefail

readonly HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
readonly MONITOR="${SABLE_MONITOR:-$HERE/sable-monitor}"
readonly ENV_FILE="${SABLE_ENV_FILE:-$(cd "$HERE/.." && pwd)/.env}"
readonly WINDOW_TIMEOUT="${SABLE_WINDOW_TIMEOUT:-30}"
# Case-sensitive on purpose: the AppImage reports Sable, a `cargo run` build reports sable.
readonly WINDOW_MATCH='^[sS]able$'

# `sable-monitor` already owns the single-instance rule and knows how Sable is started (setsid,
# the missing-AppImage warning). Calling it instead of repeating any of that keeps one
# definition of "start Sable" for the launcher and for login.
#
# Its env-file default is a hardcoded ~/Projects/sable/.env while everything here resolves
# against $HERE, so a moved checkout would keep launching happily and hand Sable a credentials
# path that no longer exists. Deriving it from this script's own location keeps the two
# together; an inherited SABLE_ENV_FILE still wins.
SABLE_ENV_FILE="$ENV_FILE" "$MONITOR"

# Hyprland only knows about the window once the app has finished coming up, so give a cold
# start room to land -- mounting the AppImage's squashfs and bringing WebKitGTK up can take
# most of a minute on a cold cache. An instance that was already running satisfies this on the
# first pass.
deadline=$((SECONDS + WINDOW_TIMEOUT))
until hyprctl clients -j | jq -e --arg match "$WINDOW_MATCH" \
  'any(.[]; (.class // "") | test($match))' >/dev/null 2>&1; do
  if ((SECONDS >= deadline)); then
    notify-send "Sable" "No window appeared within ${WINDOW_TIMEOUT}s" 2>/dev/null || true
    echo "sable-launch: no Sable window after ${WINDOW_TIMEOUT}s" >&2
    exit 1
  fi
  sleep 0.2
done

# focuswindow follows the window to whichever workspace it is parked on, which is the whole
# job here. Unlike the togglespecialworkspace this replaced it is idempotent: clicking the
# launcher while Sable is already in front leaves it in front rather than hiding it again.
hyprctl dispatch focuswindow "class:$WINDOW_MATCH" >/dev/null
